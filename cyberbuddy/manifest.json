{
  "manifest_version": 3,
  "name": "Cyber Buddy",
  "version": "1.0",
  "description": "AI-powered scam, phishing, and fraud detector for a safer digital India.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["https://api.groq.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cyber Buddy"
  }
}
